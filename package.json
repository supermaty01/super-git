{
  "name": "super-git",
  "productName": "SuperGit",
  "version": "1.3.0",
  "description": "A lightweight, local-only desktop Git client for Windows",
  "main": "./out/main/index.js",
  "author": "Mateo Álvarez",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test test/*.test.ts",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "electron-updater": "^6.8.11",
    "node-diff3": "^3.1.2"
  },
  "devDependencies": {
    "@fontsource/open-sans": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "zustand": "^5.0.5"
  },
  "build": {
    "appId": "dev.supergit.app",
    "productName": "SuperGit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "SuperGit",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "artifactName": "SuperGit-Setup-${version}.exe",
      "uninstallDisplayName": "SuperGit"
    },
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "portable": {
      "artifactName": "SuperGit-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "supermaty01",
        "repo": "super-git"
      }
    ]
  },
  "homepage": "https://github.com/supermaty01/super-git"
}
