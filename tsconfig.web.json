{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "baseUrl": ".", "paths": { "@shared/*": ["src/shared/*"], "@/*": ["src/renderer/src/*"] }, "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts"]
}
